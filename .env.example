# ============================================================
# 数据库配置 - 上线后请将以下变量填写到真实的 .env 文件中
# 将此文件复制为 .env 并填写对应值，不要把 .env 提交到 git
# ============================================================

# MySQL 主机地址（例如：127.0.0.1 或远端服务器 IP）
DB_HOST=请填写你的MySQL主机

# MySQL 端口（默认 3306）
DB_PORT=3306

# MySQL 登录用户名
DB_USER=请填写你的MySQL用户名

# MySQL 登录密码
DB_PASSWORD=请填写你的MySQL密码

# 目标数据库名（需提前在 MySQL 中创建）
DB_NAME=请填写你的MySQL库名
